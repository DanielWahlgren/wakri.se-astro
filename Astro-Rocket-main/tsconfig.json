{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@sanity/astro/module"],
  },
  "include": ["./src/**/*", "./src/env.d.ts"],
  "exclude": ["./node_modules", "./dist"]
}
