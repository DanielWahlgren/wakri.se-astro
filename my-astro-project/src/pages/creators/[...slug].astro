---
import CreatorLayout from '@/layouts/CreatorLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('creators', ({ data }) => {
    return data.locale === 'sv' && (import.meta.env.PROD ? data.draft !== true : true);
  });

  return posts.map((post) => ({
    params: { slug: post.id.replace('sv/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<CreatorLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  svgSlug={post.data.svgSlug}
  tags={post.data.tags}
  slug={post.id}
>
  <Content />
</CreatorLayout>
